# ─────────────────────────────────────────────
#  Pacomarca — configuración Apache / cPanel
# ─────────────────────────────────────────────

# Página 404 personalizada (generada por Next en /404.html)
ErrorDocument 404 /404.html

# Redirección 301: abrigando-corazones -> tejiendo-corazones
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^programas/abrigando-corazones/?$ /programas/tejiendo-corazones/ [R=301,L]
</IfModule>

# Compresión (gzip) de recursos de texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Caché de estáticos (mejora el rendimiento)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  # El HTML no se cachea agresivamente para poder actualizar contenido
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
